<!DOCTYPE html>
<html>
  <head>
    <!-- Ceremonial Metadata - The Opening Gesture -->
    <title>Phoenix Ignition - Haikus for Mona</title>
    <link href="/css/main.css" rel="stylesheet" type="text/css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <!-- Social Resonance - How the ceremony appears when shared -->
    <meta property="og:title" content="Phoenix Ignition - Ceremonial Haikus">
    <meta property="og:description" content="A collection of poetic haikus presented as ceremonial scrolls">
    <meta property="og:image" content="/images/sunlight.jpg">
  </head>
  <body>
    <!-- ✨ CEREMONIAL HEADER - The Invocation -->
    <h1>Phoenix Ignition: Haikus for Mona</h1>
    
    <!-- 🔥 MAIN RITUAL SPACE - Where Scrolls Are Revealed -->
    <div>
      <%
        /*
         * The Scroll Rendering Loop
         * Each iteration is a breath, a pulse in the ceremony
         * We present image and verse as paired glyphs
         */
        for(var i=0; i < haikus.length; i++) {
      %>
        <!-- Visual Glyph - The Octodex Companion -->
        <img
          class="mona-images"
          src="images/<%= haikus[i].image %>"
          alt="Ceremonial image for haiku <%= i + 1 %>" />
        
        <!-- Verse Container - The Sacred Text -->
        <div class="haiku-containers">
          <p class="haikus"><%- haikus[i].text %></p>
        </div>
      <% } %>
    </div>
    
    <!-- ✨ Closing: The ceremony completes, the flame continues -->
  </body>
</html>
